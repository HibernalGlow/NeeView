<UserControl x:Class="NeeView.FloatingControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NeeView"
             xmlns:properties="clr-namespace:NeeView.Properties"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance local:FloatingControlPanelViewModel}"
             d:DesignHeight="120" d:DesignWidth="400">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="ControlButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" BorderThickness="0,0,0,2" 
                                BorderBrush="Transparent" Padding="12,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource App.Accent}"/>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Panel.Background.Selected}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource Panel.Background.MouseOver}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 折叠后的侧边栏按钮 -->
        <Border Grid.Column="0" x:Name="CollapsedButton" 
                Background="{DynamicResource Panel.Background}"
                BorderBrush="{DynamicResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="0,4,4,0"
                Visibility="{Binding IsCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                MouseLeftButtonDown="CollapsedButton_MouseLeftButtonDown">
            <TextBlock Text="◀" FontSize="14" Margin="4,8" VerticalAlignment="Center"
                       Foreground="{DynamicResource Panel.Foreground}"/>
        </Border>

        <!-- 展开的控制面板 -->
        <Border Grid.Column="1" x:Name="ExpandedPanel"
                Background="{DynamicResource Panel.Background}"
                BorderBrush="{DynamicResource Panel.Border}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="▶" 
                            Style="{StaticResource ControlButtonStyle}"
                            Width="24" Height="24"
                            ToolTip="{properties:TextBinding FloatingControl.Collapse.ToolTip}"
                            Command="{Binding CollapseCommand}"/>
                    <TextBlock Text="{properties:TextBinding FloatingControl.Title}" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Panel.Foreground}"/>
                </DockPanel>

                <!-- Tab 切换 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="{properties:TextBinding FloatingControl.Tab.Image}" 
                                 Style="{StaticResource TabButtonStyle}"
                                 IsChecked="{Binding IsImageMode}"/>
                    <RadioButton Content="{properties:TextBinding FloatingControl.Tab.Video}" 
                                 Style="{StaticResource TabButtonStyle}"
                                 IsChecked="{Binding IsVideoMode}"/>
                    <RadioButton Content="{properties:TextBinding FloatingControl.Tab.Auto}" 
                                 Style="{StaticResource TabButtonStyle}"
                                 IsChecked="{Binding IsAutoMode}"/>
                </StackPanel>

                <!-- 控制内容区域 -->
                <Grid Grid.Row="2">
                    <!-- 图片控制 -->
                    <StackPanel Visibility="{Binding ShowImageControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{properties:TextBinding FloatingControl.PageControl}" 
                                   FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Panel.Foreground}"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="◀◀" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.PrevBook.ToolTip}"
                                    Command="{Binding PrevBookCommand}"/>
                            <Button Content="◀" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.PrevPage.ToolTip}"
                                    Command="{Binding PrevPageCommand}"/>
                            <Button Content="▶" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.NextPage.ToolTip}"
                                    Command="{Binding NextPageCommand}"/>
                            <Button Content="▶▶" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.NextBook.ToolTip}"
                                    Command="{Binding NextBookCommand}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- 视频控制 -->
                    <StackPanel Visibility="{Binding ShowVideoControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{properties:TextBinding FloatingControl.MediaControl}" 
                                   FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource Panel.Foreground}"/>
                        
                        <!-- 播放控制 -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="⏮" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.Media.First.ToolTip}"
                                    Command="{Binding MediaFirstCommand}"/>
                            <Button Content="⏪" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.Media.Rewind.ToolTip}"
                                    Command="{Binding MediaRewindCommand}"/>
                            <Button Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.Media.PlayPause.ToolTip}"
                                    Command="{Binding MediaTogglePlayCommand}">
                                <TextBlock Text="{Binding PlayPauseIcon}"/>
                            </Button>
                            <Button Content="⏩" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.Media.Forward.ToolTip}"
                                    Command="{Binding MediaForwardCommand}"/>
                            <Button Content="⏭" Style="{StaticResource ControlButtonStyle}"
                                    ToolTip="{properties:TextBinding FloatingControl.Media.Last.ToolTip}"
                                    Command="{Binding MediaLastCommand}"/>
                        </WrapPanel>

                        <!-- 进度条 -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="{Binding CurrentTime}" Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Panel.Foreground}"/>
                            <Slider Grid.Column="1" 
                                    Minimum="0" Maximum="1" 
                                    Value="{Binding MediaPosition}"
                                    IsEnabled="{Binding CanSeek}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding TotalTime}" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Panel.Foreground}"/>
                        </Grid>

                        <!-- 播放速度 -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Left" 
                                       Text="{properties:TextBinding FloatingControl.Media.Speed}" 
                                       Margin="0,0,8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Panel.Foreground}"/>
                            <ComboBox SelectedItem="{Binding PlaybackSpeed}" 
                                      ItemsSource="{Binding PlaybackSpeeds}"
                                      MinWidth="80"
                                      VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
