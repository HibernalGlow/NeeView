<UserControl x:Class="NeeView.SuperResolution.SuperResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NeeView.SuperResolution"
             xmlns:nw="clr-namespace:NeeView.Windows.Controls;assembly=NeeView"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Count 转 Visibility 转换器 -->
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            
            <!-- 标题和状态 -->
            <TextBlock Text="超分辨率设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- 启用开关 -->
            <CheckBox Content="启用超分辨率" 
                     IsChecked="{Binding Config.IsEnabled}"
                     FontSize="14"
                     Margin="0,5"/>

            <!-- 当前图片信息（类似 picacg 图片信息区） -->
            <GroupBox Header="当前图片" Margin="0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 文件名 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="文件：" Margin="0,2" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentImagePath}" 
                                  Margin="5,2" TextWrapping="Wrap" ToolTip="{Binding CurrentImageFullPath}"/>

                        <!-- 原图分辨率 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="原图：" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentImageResolution}" 
                                  Margin="5,2"/>

                        <!-- 超分后分辨率 (仅在已超分时显示) -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="超分后：" Margin="0,2"
                                  Visibility="{Binding SuperResolutionResolution, Converter={StaticResource CountToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SuperResolutionResolution}" 
                                  Margin="5,2" FontWeight="Bold" Foreground="Green"
                                  Visibility="{Binding SuperResolutionResolution, Converter={StaticResource CountToVisibilityConverter}}"/>

                        <!-- 超分图片路径 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="缓存：" Margin="0,2"
                                  Visibility="{Binding SuperResolutionImagePath, Converter={StaticResource CountToVisibilityConverter}}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SuperResolutionImagePath}" 
                                  Margin="5,2" FontSize="10" Foreground="Gray"
                                  Visibility="{Binding SuperResolutionImagePath, Converter={StaticResource CountToVisibilityConverter}}"/>

                        <!-- 状态 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="状态：" Margin="0,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentImageStatusText}" 
                                  Margin="5,2" FontWeight="Bold"/>

                        <!-- 超分切换 -->
                        <CheckBox Grid.Row="5" Grid.ColumnSpan="2"
                                 Content="当前图片启用超分 (切换显示)" 
                                 IsChecked="{Binding EnableCurrentImageSuperResolution}"
                                 Margin="0,5"
                                 ToolTip="勾选显示超分图，取消显示原图"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 处理选项 -->
            <GroupBox Header="处理设置" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="运算设备:" Margin="0,5,0,3"/>
                    <ComboBox ItemsSource="{Binding AvailableDevices}"
                              SelectedItem="{Binding SelectedDevice}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,0,10"/>

                    <CheckBox Content="启用结果缓存"
                             IsChecked="{Binding Config.CacheResults}"
                             Margin="0,5"
                             ToolTip="缓存超分结果以便重复使用"/>
                </StackPanel>
            </GroupBox>

            <!-- 自动超分设置 -->
            <GroupBox Header="自动超分" Margin="0,10">
                <StackPanel>
                    <CheckBox Content="查看图片时自动超分" 
                             IsChecked="{Binding Config.AutoApplyOnView}"
                             Margin="0,5"
                             ToolTip="打开图片时自动应用超分辨率处理"/>
                    
                    <StackPanel Visibility="{Binding Config.AutoApplyOnView, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <!-- 尺寸限制 -->
                        <TextBlock Text="尺寸限制:" FontWeight="Bold" Margin="0,10,0,5"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 最大尺寸(宽或高) -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="最大尺寸:" VerticalAlignment="Center" Margin="0,3"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.AutoApplyMaxSize, UpdateSourceTrigger=PropertyChanged}" 
                                    Margin="5,3" ToolTip="宽或高的最大值(像素)"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="5,3"/>

                            <!-- 宽度范围 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="宽度:" VerticalAlignment="Center" Margin="0,3"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5,3">
                                <TextBox Text="{Binding Config.AutoApplyMinWidth, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最小宽度(-1=无限制)"/>
                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Text="{Binding Config.AutoApplyMaxWidth, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最大宽度(-1=无限制)"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="5,3"/>

                            <!-- 高度范围 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="高度:" VerticalAlignment="Center" Margin="0,3"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="5,3">
                                <TextBox Text="{Binding Config.AutoApplyMinHeight, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最小高度(-1=无限制)"/>
                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Text="{Binding Config.AutoApplyMaxHeight, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最大高度(-1=无限制)"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="px" VerticalAlignment="Center" Margin="5,3"/>
                        </Grid>

                        <!-- 文件大小限制 -->
                        <TextBlock Text="文件大小:" FontWeight="Bold" Margin="0,10,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="范围:" VerticalAlignment="Center" Margin="0,3"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,3">
                                <TextBox Text="{Binding Config.AutoApplyMinFileSize, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最小文件大小(-1=无限制)"/>
                                <TextBlock Text=" ~ " VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Text="{Binding Config.AutoApplyMaxFileSize, UpdateSourceTrigger=PropertyChanged}" 
                                        Width="60" ToolTip="最大文件大小(-1=无限制)"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="KB" VerticalAlignment="Center" Margin="5,3"/>
                        </Grid>

                        <TextBlock Text="提示: -1 表示无限制" FontSize="10" Foreground="Gray" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 高级设置 -->
            <GroupBox Header="高级设置" Margin="0,10">
                <StackPanel>
                    <TextBlock Text="模型文件路径:" Margin="0,5,0,3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" 
                                Text="{Binding Config.ModelPath, UpdateSourceTrigger=PropertyChanged}"
                                IsReadOnly="True"
                                ToolTip="sr_vulkan 模型文件存放路径,空表示使用默认路径"/>
                        <Button Grid.Column="1" 
                               Content="浏览..." 
                               Margin="5,0,0,0" 
                               Padding="8,3"
                               Click="BrowseModelPath_Click"/>
                        <Button Grid.Column="2" 
                               Content="扫描" 
                               Margin="5,0,0,0" 
                               Padding="8,3"
                               Command="{Binding ScanModelsCommand}"
                               ToolTip="扫描文件夹中的模型文件"/>
                    </Grid>
                    <TextBlock Text="{Binding ModelScanStatus}" 
                              FontSize="10" 
                              Foreground="Gray"
                              Margin="0,2,0,0"/>
                    
                    <!-- 识别到的模型列表 -->
                    <StackPanel Visibility="{Binding AvailableModels.Count, Converter={StaticResource CountToVisibilityConverter}}"
                               Margin="0,10,0,0">
                        <TextBlock Text="可用模型:" Margin="0,5,0,3" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding AvailableModels}"
                                SelectedItem="{Binding SelectedModel}"
                                SelectionMode="Single"
                                MaxHeight="200"
                                BorderThickness="1"
                                BorderBrush="#CCCCCC">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected, Mode=TwoWay}"
                                              Padding="6,4">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                            <TextBlock FontSize="10" Foreground="Gray">
                                                <Run Text="文件: "/><Run Text="{Binding ModelName}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="Gray">
                                                <Run Text="大小: "/><Run Text="{Binding BinFileSize, StringFormat={}{0:N0} bytes}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 操作按钮 -->
            <Button Content="处理当前图片" 
                   Command="{Binding ProcessCurrentImageCommand}"
                   Margin="0,15"
                   Padding="10,5"
                   HorizontalAlignment="Stretch"
                   ToolTip="对当前显示的图片应用超分辨率处理"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
