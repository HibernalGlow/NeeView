<UserControl x:Class="NeeView.SuperResolution.SuperResolutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NeeView.SuperResolution"
             xmlns:nw="clr-namespace:NeeView.Windows.Controls;assembly=NeeView"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="350">
    
    <UserControl.Resources>
        <Style TargetType="GroupBox" BasedOn="{StaticResource NVGroupBox}">
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock" BasedOn="{StaticResource NVTextBlock}">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            
            <!-- 标题和状态 -->
            <TextBlock Text="Super Resolution" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                          Foreground="{DynamicResource Panel.Foreground}"
                          TextWrapping="Wrap"/>
                
                <CheckBox Grid.Column="1" Content="Enable" 
                         IsChecked="{Binding IsEnabled}"
                         VerticalAlignment="Center"
                         Margin="5,0,0,0"/>
            </Grid>

            <!-- 进度条 -->
            <ProgressBar Height="4" Value="{Binding Progress}" 
                        Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="0,0,0,10"/>

            <!-- 算法类型 -->
            <GroupBox Header="Algorithm">
                <StackPanel>
                    <ComboBox SelectedItem="{Binding Config.AlgorithmType}">
                        <ComboBoxItem Content="Waifu2x" Tag="Waifu2x"/>
                        <ComboBoxItem Content="RealESRGAN" Tag="RealESRGAN"/>
                        <ComboBoxItem Content="Real-CUGAN" Tag="RealCUGAN"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- 模型选择 -->
            <GroupBox Header="Model">
                <StackPanel>
                    <ComboBox SelectedItem="{Binding Config.Model}">
                        <ComboBoxItem Content="Waifu2x Anime 2x" Tag="Waifu2xAnime2x"/>
                        <ComboBoxItem Content="Waifu2x Anime 4x" Tag="Waifu2xAnime4x"/>
                        <ComboBoxItem Content="Waifu2x Photo 2x" Tag="Waifu2xPhoto2x"/>
                        <ComboBoxItem Content="Waifu2x Photo 4x" Tag="Waifu2xPhoto4x"/>
                        <ComboBoxItem Content="RealESRGAN Anime 4x" Tag="RealESRGANAnime4x"/>
                        <ComboBoxItem Content="RealESRGAN General 4x" Tag="RealESRGANGeneral4x"/>
                        <ComboBoxItem Content="Real-CUGAN Anime 2x" Tag="RealCUGANAnime2x"/>
                        <ComboBoxItem Content="Real-CUGAN Anime 3x" Tag="RealCUGANAnime3x"/>
                        <ComboBoxItem Content="Real-CUGAN Anime 4x" Tag="RealCUGANAnime4x"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <!-- 缩放设置 -->
            <GroupBox Header="Scale Settings">
                <StackPanel>
                    <!-- 缩放模式 -->
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <RadioButton Content="Scale Factor" 
                                   IsChecked="{Binding Config.ScaleMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ScaleFactor}"
                                   GroupName="ScaleMode"/>
                        <RadioButton Content="Target Size" 
                                   IsChecked="{Binding Config.ScaleMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=TargetSize}"
                                   GroupName="ScaleMode"
                                   Margin="20,0,0,0"/>
                    </StackPanel>

                    <!-- 缩放倍数 -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Scale Factor:"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" 
                                   Value="{Binding Config.ScaleFactor}" 
                                   Minimum="0.5" Maximum="8" 
                                   TickFrequency="0.5"
                                   IsSnapToTickEnabled="True"
                                   Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" 
                                      Text="{Binding Config.ScaleFactor, StringFormat={}{0:F1}x}"
                                      Width="40"
                                      TextAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- 目标尺寸 -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Target Size:"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                    Text="{Binding Config.TargetWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1" Text=" x " 
                                      VerticalAlignment="Center"
                                      Margin="5,0"/>
                            <TextBox Grid.Column="2" 
                                    Text="{Binding Config.TargetHeight, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 高级选项 -->
            <GroupBox Header="Advanced Options">
                <StackPanel>
                    <!-- TTA模式 -->
                    <CheckBox Content="TTA Mode (Higher quality, slower)" 
                             IsChecked="{Binding Config.UseTTA}"
                             Margin="0,5"/>

                    <!-- 降噪等级 -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Denoise Level:"/>
                        <ComboBox SelectedValue="{Binding Config.NoiseLevel}">
                            <ComboBoxItem Content="No Denoise" Tag="-1"/>
                            <ComboBoxItem Content="Level 0" Tag="0"/>
                            <ComboBoxItem Content="Level 1" Tag="1"/>
                            <ComboBoxItem Content="Level 2" Tag="2"/>
                            <ComboBoxItem Content="Level 3" Tag="3"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- GPU ID -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="GPU ID (-1 for CPU):"/>
                        <TextBox Text="{Binding Config.GpuId, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Tile Size -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Tile Size (0 for auto):"/>
                        <TextBox Text="{Binding Config.TileSize, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- 输出格式 -->
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Output Format (empty for original):"/>
                        <ComboBox SelectedValue="{Binding Config.OutputFormat}">
                            <ComboBoxItem Content="Original" Tag=""/>
                            <ComboBoxItem Content="PNG" Tag="png"/>
                            <ComboBoxItem Content="JPG" Tag="jpg"/>
                            <ComboBoxItem Content="WebP" Tag="webp"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 图片信息 -->
            <GroupBox Header="Image Info">
                <StackPanel>
                    <TextBlock>
                        <Run Text="Original Size: "/>
                        <Run Text="{Binding OriginalSize}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Target Size: "/>
                        <Run Text="{Binding TargetSize}" FontWeight="Bold"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Processing Time: "/>
                        <Run Text="{Binding ProcessingTime}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                <Button Content="Process Current Image" 
                       Command="{Binding ProcessCurrentImageCommand}"
                       IsEnabled="{Binding IsServiceAvailable}"
                       Width="150"
                       Margin="5"/>
                <Button Content="Batch Process..." 
                       Command="{Binding OpenBatchProcessCommand}"
                       IsEnabled="{Binding IsServiceAvailable}"
                       Width="150"
                       Margin="5"/>
            </StackPanel>

            <!-- 缓存设置 -->
            <GroupBox Header="Cache Settings">
                <StackPanel>
                    <CheckBox Content="Cache Results" 
                             IsChecked="{Binding Config.CacheResults}"
                             Margin="0,5"/>
                    <StackPanel Margin="0,5">
                        <TextBlock Text="Cache Path:"/>
                        <TextBox Text="{Binding Config.CachePath, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
